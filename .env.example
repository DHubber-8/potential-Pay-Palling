# Owner: Digant
# Status: in progress
# Copy and paste this file to .env, then fill in the values for your environment.
# Do not commit your .env file to version control.
# Environment example
ENV=local
DATABASE_URL=postgresql+psycopg://dispute_helper:dispute_helper@localhost:5432/dispute_helper
PAYPAL_CLIENT_ID= # Add your PayPal client ID here, which you can find in your PayPal developer dashboard.
PAYPAL_CLIENT_SECRET= # Add your PayPal client secret here, which you can find in your PayPal developer dashboard.
PAYPAL_WEBHOOK_ID= # Add your PayPal webhook ID here, which you can find in your PayPal developer dashboard. This is used to verify incoming webhook requests.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_REPORT_URL=
LLM_API_KEY=
# Comma-separated frontend origins, e.g. http://localhost:5173,https://my-frontend.onrender.com
FRONTEND_ORIGIN=http://localhost:5173
CARRIER_API_BASE_URL=
ELASTIC_URL=
ELASTIC_API_KEY=
